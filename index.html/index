      var menu = document.getElementById("mobile-menu");
      var openIcon = document.getElementById("nav-open-icon");
      var closeIcon = document.getElementById("nav-close-icon");

      function setMenu(open) {
        if (!menu) return;
        menu.classList.toggle("hidden", !open);
        if (toggle) toggle.setAttribute("aria-expanded", String(open));
        if (openIcon) openIcon.classList.toggle("hidden", open);
        if (closeIcon) closeIcon.classList.toggle("hidden", !open);
      }

      if (toggle) {
        toggle.addEventListener("click", function () {
          setMenu(menu.classList.contains("hidden"));
        });
      }
      if (menu) {
        menu.querySelectorAll("a").forEach(function (link) {
          link.addEventListener("click", function () { setMenu(false); });
        });
      }
      document.addEventListener("keydown", function (e) {
        if (e.key === "Escape" && menu && !menu.classList.contains("hidden")) setMenu(false);
      });

      /* ---------------- terminal typing ---------------- */
      var body = document.getElementById("terminal-body");
      var LINES = [
        "> system initialized...",
        "> hello, i build digital & physical realities.",
        "> stack: react · node · python · iot · edge ai",
        "> status: all systems operational"
      ];

      function typeSequence() {
        if (!body || reduceMotion) {
          renderStatic();
          return;
        }
        var cursorLine = body.querySelector(".t-line:last-child");
        var i = 0;
        function nextLine() {
          if (i >= LINES.length) {
            if (cursorLine) cursorLine.style.display = "";
            return;
          }
          var p = document.createElement("p");
          p.className = "t-line";
          var span = document.createElement("span");
          span.className = "t-out";
          p.appendChild(span);
          if (cursorLine && body.contains(cursorLine)) {
            body.insertBefore(p, cursorLine);
          } else {
            body.appendChild(p);
          }
          typeChars(span, LINES[i], function () {
            i++;
            window.setTimeout(nextLine, 320);
          });
        }
        window.setTimeout(nextLine, 700);
      }

      function typeChars(el, text, done) {
        var j = 0;
        (function tick() {
          if (j <= text.length) {
            el.textContent = text.slice(0, j);
            j++;
            window.setTimeout(tick, 42);
          } else {
            done();
          }
        })();
      }

      function renderStatic() {
        if (!body) return;
        LINES.forEach(function (line) {
          var p = document.createElement("p");
          p.className = "t-line";
          p.innerHTML = '<span class="t-out"></span>';
          p.querySelector("span").textContent = line;
          body.appendChild(p);
        });
      }

      typeSequence();

      /* ---------------- scroll reveal ---------------- */
      var reveals = document.querySelectorAll(".reveal");
      if ("IntersectionObserver" in window && !reduceMotion) {
        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (entry) {
            if (entry.isIntersecting) {
              entry.target.classList.add("in-view");
              io.unobserve(entry.target);
            }
          });
        }, { threshold: 0.12 });
        reveals.forEach(function (el) { io.observe(el); });
      } else {
        reveals.forEach(function (el) { el.classList.add("in-view"); });
      }

      /* ---------------- contact form ---------------- */
      var form = document.getElementById("contact-form");
      var status = document.getElementById("form-status");
      if (form) {
        form.addEventListener("submit", function (e) {
          e.preventDefault();
          var email = document.getElementById("email");
          var message = document.getElementById("message");
          var emailVal = email ? email.value.trim() : "";
          var msgVal = message ? message.value.trim() : "";

          if (!emailVal || !msgVal) {
            setStatus("> error: incomplete transmission", "#FF5F57");
            return;
          }
          if (emailVal.indexOf("@") === -1) {
            setStatus("> error: invalid address format", "#FF5F57");
            return;
          }

          setStatus("> transmitting...", "#00F0FF");
          window.setTimeout(function () {
            setStatus("> message received ✓", "#39FF14");
            if (email) email.value = "";
            if (message) message.value = "";
          }, 1200);
        });
      }

      function setStatus(text, color) {
        if (status) {
          status.textContent = text;
          status.style.color = color;
        }
      }
    })();
  </script>
</body>
</html>