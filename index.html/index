  <style>
    :root {
      --bg-deep: #0B0F19;
      --bg-panel: rgba(255, 255, 255, 0.04);
      --cyan: #00F0FF;
      --purple: #B026FF;
      --neon: #39FF14;
      --text-main: #E6F1FF;
      --text-dim: #7B8CA8;
      --font-sans: "Inter", system-ui, -apple-system, sans-serif;
      --font-mono: "JetBrains Mono", ui-monospace, SFMono-Regular, monospace;
    }

    html { scroll-behavior: smooth; }
    body {
      background: var(--bg-deep);
      color: var(--text-main);
      font-family: var(--font-sans);
      overflow-x: hidden;
    }
    ::selection { background: rgba(0, 240, 255, 0.25); color: #fff; }

    /* ---------- ambient background layers ---------- */
    .bg-fx { position: fixed; inset: 0; z-index: -2; pointer-events: none; }
    .bg-grid {
      position: absolute; inset: 0;
      background-image:
        linear-gradient(rgba(0, 240, 255, 0.045) 1px, transparent 1px),
        linear-gradient(90deg, rgba(0, 240, 255, 0.045) 1px, transparent 1px);
      background-size: 44px 44px;
      mask-image: radial-gradient(ellipse 90% 70% at 50% 0%, black 30%, transparent 100%);
      -webkit-mask-image: radial-gradient(ellipse 90% 70% at 50% 0%, black 30%, transparent 100%);
    }
    .bg-aura {
      position: absolute;
      border-radius: 50%;
      filter: blur(90px);
      opacity: 0.22;
    }
    .bg-aura.cyan   { width: 520px; height: 520px; top: -140px; right: -120px; background: var(--cyan); }
    .bg-aura.purple { width: 460px; height: 460px; top: 40%; left: -160px; background: var(--purple); }
    .scanlines {
      position: absolute; inset: 0;
      background: repeating-linear-gradient(0deg, rgba(255,255,255,0.028) 0 1px, transparent 1px 3px);
      mix-blend-mode: overlay;
    }

    /* ---------- typography helpers ---------- */
    .mono { font-family: var(--font-mono); }
    .section-tag {
      font-family: var(--font-mono);
      letter-spacing: 0.2em;
      font-size: 0.72rem;
      color: var(--cyan);
      text-transform: uppercase;
    }

    /* ---------- glass ---------- */
    .glass {
      background: rgba(255, 255, 255, 0.04);
      backdrop-filter: blur(14px);
      -webkit-backdrop-filter: blur(14px);
      border: 1px solid rgba(255, 255, 255, 0.08);
      border-radius: 1rem;
    }
    @supports not (backdrop-filter: blur(14px)) {
      .glass { background: rgba(11, 15, 25, 0.92); }
    }

    /* ---------- glow / hover ---------- */
    .card-hover { transition: transform .25s ease, border-color .25s ease, box-shadow .25s ease; }
    .card-hover:hover {
      transform: translateY(-6px);
      border-color: rgba(0, 240, 255, 0.55);
      box-shadow: 0 0 26px rgba(0, 240, 255, 0.22), 0 0 70px rgba(176, 38, 255, 0.14);
    }

    .btn-primary {
      font-family: var(--font-mono);
      background: rgba(0, 240, 255, 0.08);
      border: 1px solid rgba(0, 240, 255, 0.55);
      color: var(--cyan);
      box-shadow: 0 0 14px rgba(0, 240, 255, 0.28), inset 0 0 14px rgba(0, 240, 255, 0.08);
      transition: box-shadow .2s ease, background .2s ease, transform .2s ease;
    }
    .btn-primary:hover {
      background: rgba(0, 240, 255, 0.16);
      box-shadow: 0 0 30px rgba(0, 240, 255, 0.55), 0 0 90px rgba(0, 240, 255, 0.25), inset 0 0 20px rgba(0, 240, 255, 0.15);
    }
    .btn-primary:active { transform: scale(0.98); }

    .btn-ghost {
      font-family: var(--font-mono);
      border: 1px solid rgba(255, 255, 255, 0.18);
      color: var(--text-dim);
      transition: all .2s ease;
    }
    .btn-ghost:hover {
      border-color: var(--purple);
      color: var(--text-main);
      box-shadow: 0 0 22px rgba(176, 38, 255, 0.4);
    }

    /* ---------- nav ---------- */
    .nav-link {
      font-family: var(--font-mono);
      letter-spacing: 0.12em;
      color: var(--text-dim);
      transition: color .2s ease, text-shadow .2s ease;
    }
    .nav-link:hover {
      color: var(--cyan);
      text-shadow: 0 0 12px rgba(0, 240, 255, 0.8);
    }

    /* ---------- tech badges ---------- */
    .badge {
      font-family: var(--font-mono);
      font-size: 0.72rem;
      padding: 0.3rem 0.7rem;
      border-radius: 999px;
      border: 1px solid rgba(255, 255, 255, 0.12);
      color: var(--text-main);
      background: rgba(255, 255, 255, 0.03);
      transition: border-color .2s ease, box-shadow .2s ease, color .2s ease;
    }
    .badge:hover { border-color: var(--cyan); color: var(--cyan); box-shadow: 0 0 12px rgba(0, 240, 255, 0.35); }

    /* ---------- terminal ---------- */
    .terminal {
      font-family: var(--font-mono);
      background: rgba(8, 12, 22, 0.85);
      backdrop-filter: blur(10px);
      -webkit-backdrop-filter: blur(10px);
      border: 1px solid rgba(0, 240, 255, 0.25);
      border-radius: 0.9rem;
      box-shadow: 0 0 34px rgba(0, 240, 255, 0.16), 0 20px 60px rgba(0, 0, 0, 0.5);
      overflow: hidden;
    }
    .terminal-bar {
      display: flex; align-items: center; gap: 0.5rem;
      padding: 0.7rem 1rem;
      background: rgba(255, 255, 255, 0.04);
      border-bottom: 1px solid rgba(255, 255, 255, 0.07);
    }
    .t-dot { width: 11px; height: 11px; border-radius: 50%; }
    .t-line { min-height: 1.5rem; line-height: 1.5rem; }
    .t-prompt { color: var(--cyan); }
    .t-cmd { color: var(--text-main); }
    .t-out { color: var(--text-dim); }
    .t-cursor {
      display: inline-block; width: 0.6em; height: 1.15em;
      background: var(--cyan); vertical-align: text-bottom;
      box-shadow: 0 0 10px rgba(0, 240, 255, 0.9);
      animation: blink 1s steps(1) infinite;
    }
    @keyframes blink { 50% { opacity: 0; } }

    /* ---------- status dot ---------- */
    .dot-live { width: 8px; height: 8px; border-radius: 50%; background: var(--neon); box-shadow: 0 0 8px var(--neon); animation: pulse 2s ease-in-out infinite; }
    @keyframes pulse { 0%,100% { opacity: 1; } 50% { opacity: 0.35; } }

    /* ---------- project art placeholder ---------- */
    .proj-art {
      position: relative;
      height: 10rem;
      border-radius: 0.75rem;
      overflow: hidden;
      border: 1px solid rgba(255, 255, 255, 0.08);
    }
    .proj-art .grid-lines {
      position: absolute; inset: 0;
      background-image:
        linear-gradient(rgba(0,240,255,0.12) 1px, transparent 1px),
        linear-gradient(90deg, rgba(0,240,255,0.12) 1px, transparent 1px);
      background-size: 22px 22px;
    }
    .proj-art .emblem {
      position: absolute; inset: 0;
      display: grid; place-items: center;
      font-family: var(--font-mono);
      font-size: 2.2rem;
      color: rgba(255, 255, 255, 0.75);
      text-shadow: 0 0 18px rgba(0,240,255,0.6);
    }
    .proj-art.grad-cyan { background: linear-gradient(135deg, rgba(0,240,255,0.28), rgba(11,15,25,0.4) 60%); }
    .proj-art.grad-purple { background: linear-gradient(135deg, rgba(176,38,255,0.3), rgba(11,15,25,0.4) 60%); }
    .proj-art.grad-mixed { background: linear-gradient(135deg, rgba(0,240,255,0.2) 0%, rgba(176,38,255,0.26) 100%); }

    /* ---------- contact input ---------- */
    .cmd-input {
      font-family: var(--font-mono);
      background: transparent;
      color: var(--text-main);
      caret-color: var(--cyan);
      outline: none;
      width: 100%;
    }
    .cmd-input::placeholder { color: rgba(123, 140, 168, 0.7); }

    /* ---------- scroll reveal ---------- */
    .reveal { opacity: 0; transform: translateY(22px); transition: opacity .7s ease, transform .7s ease; }
    .reveal.in-view { opacity: 1; transform: none; }
    .reveal[data-delay="1"] { transition-delay: .12s; }
    .reveal[data-delay="2"] { transition-delay: .24s; }

    /* ---------- reduced motion ---------- */
    @media (prefers-reduced-motion: reduce) {
      html { scroll-behavior: auto; }
      .t-cursor, .dot-live { animation: none; }
      .reveal { opacity: 1; transform: none; transition: none; }
      .card-hover { transition: none; }
    }
  </style>
</head>
